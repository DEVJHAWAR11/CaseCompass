# Copy to .env and fill in. Never commit .env. Backend only: none of these go in frontend code.

# Indian Kanoon API (public/private key request signing)
IK_PUBLIC_KEY=
IK_PRIVATE_KEY=
IK_BASE_URL=https://api.indiankanoon.org
IK_BALANCE_FLOOR_INR=50

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_SMALL_MODEL=
LLM_LARGE_MODEL=
LLM_DAILY_TOKEN_BUDGET=200000
LLM_MAX_CALLS_PER_REQUEST=3

# Jina AI (embeddings + reranker). Free key is non-commercial only.
JINA_API_KEY=
EMBED_MODEL=
EMBED_DIM=
RERANK_MODEL=
JINA_POOL_TOKENS=10000000
JINA_WARN_FRACTION=0.70
JINA_STOP_FRACTION=0.90
JINA_MAX_REQ_PER_MIN=100
JINA_MAX_TOKENS_PER_MIN=100000

# Supabase Postgres
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# API
RATE_LIMIT_PER_MIN=10
CORS_ORIGINS=http://localhost:3000
CACHE_DIR=data/cache

# Indian Kanoon single API token (if the account uses token auth instead of key signing)
IK_API_TOKEN=
